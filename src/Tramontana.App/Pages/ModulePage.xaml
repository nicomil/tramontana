<Page
    x:Class="Tramontana.App.Pages.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:Tramontana.App.Services">
    <Page.Resources>
        <CollectionViewSource x:Name="GroupedCategories" IsSourceGrouped="True" />
    </Page.Resources>
    <Grid Padding="28,12,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource Caption}" MaxWidth="760" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="UnlockButton" Click="Unlock_Click" Visibility="Collapsed" ToolTipService.ToolTip="Analizza anche le cartelle di Windows (chiede l'amministratore una volta)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA18;" FontSize="14" />
                        <TextBlock Text="Sblocca funzioni di sistema" />
                    </StackPanel>
                </Button>
                <Button Click="Cancel_Click" Visibility="{x:Bind s:Converters.Visible(State.IsBusy), Mode=OneWay}">Annulla</Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" IsEnabled="{x:Bind s:Converters.Not(State.IsBusy), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock x:Name="ScanLabel" Text="Analizza" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind s:Converters.Visible(State.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind State.Status, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind s:Converters.VisibleIfText(State.Status), Mode=OneWay}" />
            <InfoBar x:Name="CleanBar" Severity="Success" IsClosable="True" IsOpen="False" Title="Pulizia completata">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="OpenBinButton" Content="Apri il Cestino" Click="OpenBin_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <ItemsControl x:Name="NotesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <InfoBar Severity="Informational" IsOpen="True" IsClosable="True" Message="{x:Bind}" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind s:Converters.Collapsed(State.HasResults), Mode=OneWay}">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xEA99;" FontSize="56" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="EmptyText" Text="Avvia l'analisi per vedere cosa si può togliere." HorizontalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16" Visibility="{x:Bind s:Converters.Visible(State.HasResults), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="280" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4">
                <ListView x:Name="CategoryList" ItemsSource="{x:Bind GroupedCategories.View, Mode=OneWay}" SelectionMode="Single"
                          SelectionChanged="CategoryList_SelectionChanged">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="s:CategoryGroup">
                                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="s:CategoryViewModel">
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsThreeState="False" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="CategoryCheck_Click" MinWidth="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Glyph="&#xEA18;" FontSize="12" Visibility="{x:Bind AdminVisibility}" ToolTipService.ToolTip="Richiede l'amministratore" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind SelectedSummary, Mode=OneWay}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind State.SelectedCategory.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind State.SelectedCategory.Description, Mode=OneWay}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <AutoSuggestBox Grid.Column="1" Width="200" PlaceholderText="Filtra" QueryIcon="Find" VerticalAlignment="Top"
                                        Text="{x:Bind State.Filter, Mode=TwoWay}" />
                    </Grid>
                    <ListView Grid.Row="1" x:Name="ItemList" ItemsSource="{x:Bind State.VisibleItems, Mode=OneWay}" SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="s:ItemViewModel">
                                <Grid ColumnSpacing="10" Padding="0,4" Background="Transparent" RightTapped="Item_RightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanCheck}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind RiskGlyph}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{x:Bind RiskVisibility}" ToolTipService.ToolTip="{x:Bind RiskText}" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Glyph="&#xEA18;" FontSize="12" Visibility="{x:Bind AdminVisibility}" ToolTipService.ToolTip="Richiede l'amministratore" />
                                            <Border Visibility="{x:Bind KeptVisibility}" CornerRadius="4" Padding="6,0" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                                <TextBlock Text="da tenere" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12" Visibility="{x:Bind s:Converters.Visible(State.HasResults), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton Content="Selezione">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Seleziona tutto" Click="SelectAll_Click" />
                        <MenuFlyoutItem Text="Deseleziona tutto" Click="SelectNone_Click" />
                        <MenuFlyoutItem Text="Selezione consigliata" Click="SelectDefault_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="1" Text="{x:Bind State.SelectionText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ComboBox Grid.Column="2" x:Name="ModeBox" Width="220" VerticalAlignment="Center" />
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="Clean_Click" IsEnabled="{x:Bind State.CanClean, Mode=OneWay}" MinWidth="120">
                <TextBlock x:Name="CleanLabel" Text="Pulisci" />
            </Button>
        </Grid>
    </Grid>
</Page>

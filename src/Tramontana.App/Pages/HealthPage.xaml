<Page
    x:Class="Tramontana.App.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,12,28,28" Spacing="24" MaxWidth="1100">
            <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,16,0,0">
                <FontIcon Glyph="&#xE95E;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Headline" Text="Controlla tutto il PC in un clic" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Subline" Text="Pulizia, protezione, aggiornamenti e programmi all'avvio. Viene pulito solo ciò che confermi." Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Click="Run_Click" MinWidth="180" Padding="20,10">
                        <TextBlock x:Name="RunLabel" Text="Avvia il controllo" FontSize="16" />
                    </Button>
                    <ProgressRing x:Name="Ring" IsActive="False" Width="28" Height="28" />
                </StackPanel>
            </StackPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Severity="Success" />
            <VariableSizedWrapGrid x:Name="Cards" Orientation="Horizontal" ItemWidth="340" ItemHeight="196" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>

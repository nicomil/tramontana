<Window
    x:Class="Tramontana.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tramontana">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="Tramontana" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border x:Name="AdminBadge" Visibility="Collapsed" CornerRadius="4" Padding="6,1" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock Text="Funzioni di sistema attive" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="Nav_SelectionChanged">
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No console window: the helper runs hidden. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>wchelper</AssemblyName>
    <RootNamespace>WinCleaner.Helper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Published as one compressed file: the bootstrap copies and checks exactly one file. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Both targets in the lock file, so publish.ps1 can publish in locked mode without a second restore. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- DOTNET_STARTUP_HOOKS in the user's environment must not load code into the elevated helper. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- The SHA-256 of WinCleaner.dll this helper serves, set by scripts\publish.ps1 (-p:WcAppSha256=...). -->
    <WcAppSha256 Condition="'$(WcAppSha256)' == ''"></WcAppSha256>
    <!-- The SHA-1 thumbprint of the certificate the app is signed with (-p:WcSignerThumbprint=...). -->
    <WcSignerThumbprint Condition="'$(WcSignerThumbprint)' == ''"></WcSignerThumbprint>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WinCleaner.AppSha256" Value="$(WcAppSha256)" />
    <AssemblyMetadata Include="WinCleaner.SignerThumbprint" Value="$(WcSignerThumbprint)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinCleaner.Modules\WinCleaner.Modules.csproj" />
  </ItemGroup>
</Project>

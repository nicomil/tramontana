<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No console window: the helper runs hidden. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>wchelper</AssemblyName>
    <RootNamespace>WinCleaner.Helper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Published as one compressed file: the bootstrap copies and checks exactly one file. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinCleaner.Modules\WinCleaner.Modules.csproj" />
  </ItemGroup>
</Project>

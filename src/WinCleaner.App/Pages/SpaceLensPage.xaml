<Page
    x:Class="WinCleaner.App.Pages.SpaceLensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:WinCleaner.App.Controls">
    <Grid Padding="28,12,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Analisi disco" Style="{StaticResource PageTitle}" />
                <TextBlock Text="La mappa dello spazio occupato: ogni riquadro è grande quanto la cartella o il file. I collegamenti non vengono seguiti e i file presenti più volte (hard link) contano una volta." Style="{StaticResource Caption}" MaxWidth="760" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="DriveBox" Width="200" />
                <Button Click="PickFolder_Click" ToolTipService.ToolTip="Scegli una cartella">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
                <Button x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed">Annulla</Button>
                <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click">Analizza</Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" />
            <BreadcrumbBar x:Name="Crumbs" ItemClicked="Crumbs_ItemClicked" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="6">
                <c:Treemap x:Name="Map" />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                <ListView x:Name="ChildList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ChildList_ItemClick" />
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="FooterText" Style="{StaticResource Caption}" />
    </Grid>
</Page>

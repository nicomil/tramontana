<Page
    x:Class="WinCleaner.App.Pages.ProgramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,12,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Disinstallazione" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Programmi e app dello Store. La disinstallazione usa il programma di disinstallazione di ciascuno; dopo vengono cercati gli avanzi, che controlli prima di toglierli." Style="{StaticResource Caption}" MaxWidth="760" HorizontalAlignment="Left" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Cerca per nome o editore" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <ComboBox Grid.Column="1" x:Name="KindBox" Width="170" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Tutti" IsSelected="True" />
                <ComboBoxItem Content="Programmi" />
                <ComboBoxItem Content="App dello Store" />
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="SortBox" Width="190" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Nome" IsSelected="True" />
                <ComboBoxItem Content="Dimensione" />
                <ComboBoxItem Content="Data di installazione" />
                <ComboBoxItem Content="Ultimo uso" />
            </ComboBox>
            <Button Grid.Column="3" Click="Refresh_Click" ToolTipService.ToolTip="Aggiorna l'elenco">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged" />
                    <ProgressRing x:Name="Loading" IsActive="True" Width="40" Height="40" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer>
                    <StackPanel x:Name="Details" Spacing="10" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

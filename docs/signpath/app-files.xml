<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-files": the GitHub Actions artifact is a zip with the
     app's own executables and libraries. Tramontana.dll is not in it on purpose: its SHA-256 is
     compiled into trhelper.exe before signing (docs/code-signing-policy.md). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Tramontana.exe" product-name="Tramontana">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="trhelper.exe" product-name="Tramontana">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Tramontana.Core.dll" product-name="Tramontana">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Tramontana.Modules.dll" product-name="Tramontana">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
